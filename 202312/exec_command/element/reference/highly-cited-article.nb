Cell[BoxData[
 RowBox[{
  RowBox[{"ndiff", "[", 
   RowBox[{"l_", ",", "w_"}], "]"}], ":=", 
  RowBox[{"BlockMap", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "-", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"w", "-", "1"}], ")"}]}], "&"}], ",", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"w", "-", "1"}], "}"}]}], "]"}], ",", "l"}], "]"}], ",", "w",
     ",", "1"}], "]"}]}]], "Input",
