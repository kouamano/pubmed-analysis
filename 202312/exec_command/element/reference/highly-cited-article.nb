        RowBox[{"\"\<A+\>\"", "->", "Ap"}], ",", 
        RowBox[{"\"\<A\>\"", "->", "A"}], ",", 
        RowBox[{"\"\<len\>\"", "->", "len"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
