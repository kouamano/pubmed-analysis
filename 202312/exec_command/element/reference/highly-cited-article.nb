Cell[BoxData[
 RowBox[{
  RowBox[{"toItemNormarizeMat", "[", "l_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", "key"}], "}"}], ",", "\[IndentingNewLine]", 
