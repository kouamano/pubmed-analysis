Cell[BoxData[
 RowBox[{
  RowBox[{"blkToTitleRule", "[", "file_String", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "st", ",", "st1", ",", "st2", ",", "st3", ",", "st3case", ",", 
      "st3case2", ",", "st3rule"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"st", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"file", ",", "\"\<String\>\""}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"st1", "=", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"StringSplit", "[", 
         RowBox[{"st", ",", "\"\<<PubmedArticle>\>\""}], "]"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"st2", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"StringSplit", "[", 
          RowBox[{"#", ",", "\"\<\\n\>\""}], "]"}], "&"}], ",", 
        RowBox[{"StringSplit", "[", 
         RowBox[{"st1", ",", "\"\<\\n--\\n\>\""}], "]"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"st3", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"StringReplace", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{
            "RegularExpression", 
             "[", "\"\<\\\\[\\\\[\\\\[.*\\\\]\\\\]\\\\]\>\"", "]"}], 
            "->", "\"\<\>\""}]}], "]"}], "&"}], ",", "st2", ",", 
        RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"st3case", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"titlecase", ",", "st3"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"st3case2", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "2"}], "]"}], "]"}], "&"}], ",", 
        RowBox[{"Select", "[", 
         RowBox[{"st3case", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], ">=", "2"}], "&"}]}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"st3rule", "=", 
      RowBox[{"MapApply", "[", 
       RowBox[{"Rule", ",", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", "st3case2", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9609271190825367`*^9, 3.960927304197393*^9}, {
