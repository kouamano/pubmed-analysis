      RowBox[{"Keys", "[", 
       RowBox[{"l", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"m", "=", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Normal", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "&"}], ",", "l"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"None", "->", "0"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{"Normalize", ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", "m", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], "]"}], "//", "N"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
