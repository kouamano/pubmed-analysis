Cell[BoxData[
 RowBox[{
  RowBox[{"ndiff", "[", 
   RowBox[{"l_", ",", "w_"}], "]"}], ":=", 
  RowBox[{"BlockMap", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "-", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"w", "-", "1"}], ")"}]}], "&"}], ",", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"w", "-", "1"}], "}"}]}], "]"}], ",", "l"}], "]"}], ",", "w",
     ",", "1"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.966539295668336*^9, 3.966539328592161*^9}, {
  3.966540122753315*^9, 3.966540130086569*^9}, {3.966540270999218*^9, 
