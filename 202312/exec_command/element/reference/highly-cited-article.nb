Cell[BoxData[
 RowBox[{
  RowBox[{"toCitedyearlist", "[", "l_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "citedPMID", "}"}], ",", "\[IndentingNewLine]", 
