Cell[BoxData[
 RowBox[{
  RowBox[{"withG", "[", 
   RowBox[{"currentList_List", ",", "currentG_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"len", ",", "prevG"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"prevG", "=", 
      RowBox[{"currentG", "-", "5"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"len", "=", 
      RowBox[{"Length", "[", "currentList", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"prevG", "[", "#", "]"}], "->", 
           RowBox[{"currentG", "[", "n", "]"}]}], "&"}], ",", 
         RowBox[{"currentList", "[", 
          RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "len"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
