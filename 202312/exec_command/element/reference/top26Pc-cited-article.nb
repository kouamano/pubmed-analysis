Cell[BoxData[
 RowBox[{
  RowBox[{"Gsf", "[", "l_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"len", ",", "Ct", ",", "Yr"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"len", "=", 
      RowBox[{"Length", "[", "l", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Ct", "=", 
      RowBox[{"Total", "[", "l", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Yr", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Table", "[", 
        RowBox[{"n", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"Length", "[", "l", "]"}]}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Ct", "==", "0"}], ",", "1", ",", 
       RowBox[{"1", "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", 
             RowBox[{"Total", "[", 
              RowBox[{"Yr", " ", "*", " ", "l"}], "]"}]}], "-", "Ct"}], ")"}],
           " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"len", " ", "*", " ", "Ct"}], ")"}]}], ")"}]}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
