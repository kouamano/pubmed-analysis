         RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"w", "-", "1"}], ")"}]}], "&"}], ",", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
