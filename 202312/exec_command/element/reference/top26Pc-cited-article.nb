Cell[BoxData[
 RowBox[{
  RowBox[{"basicStat", "[", "citedcount_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "len", ",", "argPeak", ",", "peakYear", ",", "max", ",", "sustainYear", ",",
       "decayTH", ",", "acR", ",", "decayPlist", ",", "decayCited", ",", 
      "decayPeriod", ",", "firstCitedYear", ",", "total", ",", "Av5year", ",",
       "diff", ",", "diff2", ",", "diffTotal"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"decayTH", "=", "0.05"}], ";", "\[IndentingNewLine]", 
     RowBox[{"len", "=", 
      RowBox[{"Length", "[", "citedcount", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"argPeak", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"citedcount", ",", 
         RowBox[{"max", "=", 
          RowBox[{"Max", "[", "citedcount", "]"}]}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"peakYear", "=", 
      RowBox[{"argPeak", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sustainYear", "=", 
      RowBox[{"len", "-", 
       RowBox[{"argPeak", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"acR", "=", 
      RowBox[{"acRatio", "[", "citedcount", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"decayPlist", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"acRatio", "[", "citedcount", "]"}], ",", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", "<=", "decayTH"}]}]}], "]"}], "]"}], ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", ">", "peakYear"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"decayCited", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"citedcount", "[", 
        RowBox[{"[", 
         RowBox[{";;", 
          RowBox[{"Min", "[", "decayPlist", "]"}]}], "]"}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"decayPeriod", "=", 
      RowBox[{
       RowBox[{"Min", "[", "decayPlist", "]"}], "-", "peakYear"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "decayPlist", "]"}], "<=", "0"}], ",", 
       RowBox[{"decayPeriod", "=", "\"\<InDecay\>\""}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"firstCitedYear", "=", 
      RowBox[{
       RowBox[{"Min", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"citedcount", ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", ">", "0"}]}]}], "]"}], "]"}], "-", "1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"total", "=", 
      RowBox[{"Total", "[", "citedcount", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Av5year", "=", 
      RowBox[{"MovingAverage", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"citedcount", ",", 
          RowBox[{"Table", "[", 
           RowBox[{"0", ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "4"}], "}"}]}], "]"}]}], "]"}], ",", "5"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diff", "=", 
      RowBox[{"ndiff", "[", "Av5year", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diff2", "=", 
      RowBox[{"ndiff", "[", "diff", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diffTotal", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"diff", "//", "N"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Association", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<len\>\"", "->", "len"}], ",", 
        RowBox[{"\"\<peakYear\>\"", "->", "peakYear"}], ",", 
        RowBox[{"\"\<peakCount\>\"", "->", "max"}], ",", 
        RowBox[{
         RowBox[{"\"\<peakRatio\>\"", "->", 
          RowBox[{"max", "/", "decayCited"}]}], "//", "N"}], ",", 
        RowBox[{"\"\<acRatio\>\"", "->", "acR"}], ",", 
        RowBox[{
         RowBox[{"\"\<peakPosition\>\"", "->", 
          RowBox[{"peakYear", "/", 
           RowBox[{"Min", "[", "decayPlist", "]"}]}]}], "//", "N"}], ",", 
        RowBox[{"\"\<sustainYear\>\"", "->", "sustainYear"}], ",", 
        RowBox[{"\"\<decayCited\>\"", "->", "decayCited"}], ",", 
        RowBox[{"\"\<decayPeriod\>\"", "->", "decayPeriod"}], ",", 
        RowBox[{"\"\<firstCitedYear\>\"", "->", "firstCitedYear"}], ",", 
        RowBox[{"\"\<totalCited\>\"", "->", "total"}], ",", 
        RowBox[{"\"\<V:Av5year\>\"", "->", 
         RowBox[{"myVar", "[", 
          RowBox[{"Av5year", "//", "N"}], "]"}]}], ",", 
        RowBox[{"\"\<V:diff\>\"", "->", 
         RowBox[{"myVar", "[", 
          RowBox[{"diff", "//", "N"}], "]"}]}], ",", 
        RowBox[{"\"\<V:diff2\>\"", "->", 
         RowBox[{"myVar", "[", 
          RowBox[{"diff2", "//", "N"}], "]"}]}], ",", 
        RowBox[{"\"\<diffTotal\>\"", "->", "diffTotal"}], ",", 
        RowBox[{"\"\<diffSeq\>\"", "->", "diff"}]}], "}"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.966307216608432*^9, 3.966307412237606*^9}, {
