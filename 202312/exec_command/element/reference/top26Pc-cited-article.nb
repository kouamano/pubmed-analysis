Cell[BoxData[
 RowBox[{
  RowBox[{"binMaxPosition", "[", 
   RowBox[{"l_", ",", 
    RowBox[{"{", 
     RowBox[{"min_", ",", "max_", ",", "step_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"span", ",", "BC", ",", "maxV", ",", "maxP"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"span", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"n", ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "min", ",", "max", ",", "step"}], "}"}]}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"BC", "=", 
      RowBox[{"BinCounts", "[", 
       RowBox[{"l", ",", 
        RowBox[{"{", 
         RowBox[{"min", ",", "max", ",", "step"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"maxV", "=", 
      RowBox[{"Max", "[", "BC", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"maxP", "=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"BC", ",", "maxV"}], "]"}], "//", "Flatten"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"span", ",", "BC", ",", "maxV", ",", "maxP", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"span", "[", 
            RowBox[{"[", "maxP", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"span", "[", 
             RowBox[{"[", "maxP", "]"}], "]"}], "+", "step"}]}], "}"}]}], 
        "}"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"maxV", ",", "maxP", ",", 
       RowBox[{"span", "[", 
        RowBox[{"[", "maxP", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"span", "[", 
         RowBox[{"[", "maxP", "]"}], "]"}], "+", "step"}]}], "}"}]}]}], 
