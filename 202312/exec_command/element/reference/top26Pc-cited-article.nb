          RowBox[{"x", ">", "0"}]}]}], "]"}], "//", "Total"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Gs", "=", 
      RowBox[{
       RowBox[{"Gsf", "[", "l", "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Association", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\"\<Gs\>\"", "->", "Gs"}], ",", 
