Cell[BoxData[
 RowBox[{
  RowBox[{"replaceCitedCount", "[", 
   RowBox[{"y_", ",", "l_", ",", "ty_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"prepos", ",", "pos", ",", "lastVal", ",", "replist"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"prepos", "=", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{"ty", ",", "y"}], "]"}], "//", "Flatten"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pos", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"prepos", "==", 
         RowBox[{"{", "}"}]}], ",", "1", ",", 
        RowBox[{"prepos", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lastVal", "=", 
      RowBox[{"l", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", "pos"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"replist", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"n", "->", "lastVal"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "pos", ",", 
          RowBox[{"Length", "[", "ty", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"ReplacePart", "[", 
        RowBox[{
         RowBox[{"l", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "replist"}], "]"}]}], 
      "}"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
