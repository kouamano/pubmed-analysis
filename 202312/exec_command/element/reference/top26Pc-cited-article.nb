      "Gs", ",", "Ang", ",", "Ap", ",", "normstep", ",", "normseq", ",", 
      "Aseq"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ac", "=", 
      RowBox[{
       RowBox[{"Accumulate", "[", "l", "]"}], "//", "N"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ht", "=", 
      RowBox[{"Last", "[", "ac", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"len", "=", 
      RowBox[{"Length", "[", "ac", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"area", "=", 
      RowBox[{"ht", "*", "len"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"acR", "=", 
      RowBox[{"ac", "/", "area"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"normstep", "=", 
      RowBox[{
       RowBox[{"Last", "[", "acR", "]"}], "/", "len"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"normseq", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"normstep", "*", "n"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "len"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Aseq", "=", 
      RowBox[{"normseq", "-", "acR"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"Total", "[", "Aseq", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Ang", "=", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"Aseq", ",", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", "<", "0"}]}]}], "]"}], "//", "Total"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Ap", "=", 
      RowBox[{
       RowBox[{"Cases", "[", 
