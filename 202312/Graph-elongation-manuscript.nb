Cell["\:30b0\:30e9\:30d5\:8907\:96d1\:6027", "Text",
 CellChangeTimes->{{3.937525638457006*^9, 
  3.93752564279105*^9}},ExpressionUUID->"71ce1b6e-8934-4f78-8922-\
66c4689b961d"],

Cell["\<\
graphRedundancyComplexity[g_Graph] := Module[{vc, ec, ecmean, etp},
  vc = VertexCount[g] // N;
  ec = EdgeCount[g] // N;
  ecmean = ec/(vc^2);
  etp = Entropy[AdjacencyMatrix[g] // Flatten] // N;
  (vc) (vc^ecmean) Exp[etp]
  ]\
\>", "Text",
 CellChangeTimes->{
  3.9376377338784027`*^9},ExpressionUUID->"cae66ee5-b604-441a-a82f-\
39bb76acc6e0"]
}, Open  ]]
}, Open  ]]
