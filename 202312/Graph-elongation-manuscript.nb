Cell["\:8907\:96d1\:6027\:5b9a\:7fa9\:306e\:6848", "Text",
 CellChangeTimes->{{3.997309473016341*^9, 
  3.9973094766820507`*^9}},ExpressionUUID->"0415db1b-3125-47a0-85c7-\
679aeb92c934"],

Cell["\<\
graphRedundancyComplexity[g_Graph] := Module[{vc, ec, ecmean, etp},
  vc = VertexCount[g] // N;
  ec = EdgeCount[g] // N;
  ecmean = ec/(vc^2);
  etp = Entropy[AdjacencyMatrix[g] // Flatten] // N;
  (vc) (vc^ecmean) Exp[etp]
  ]\
\>", "Text",
 CellChangeTimes->{
  3.9376377338784027`*^9},ExpressionUUID->"cae66ee5-b604-441a-a82f-\
39bb76acc6e0"]
}, Open  ]]
}, Open  ]]
},
